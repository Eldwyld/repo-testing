{
  "agents": ["scout", "analyst", "builder"],
  "default_branch": "main",
  "cadence_minutes": 20,
  "budget": {
    "tokens_per_agent_per_day": 350000,
    "tokens_per_day_total": 1100000,
    "max_tokens_per_cycle": 12000
  },
  "providers": [
    {
      "name": "cerebras",
      "base_url": "https://api.cerebras.ai/v1",
      "key_env": "CEREBRAS_API_KEY",
      "model": "gpt-oss-120b",
      "daily_tokens": 1000000,
      "retry_seconds": 15
    },
    {
      "name": "groq",
      "base_url": "https://api.groq.com/openai/v1",
      "key_env": "GROQ_API_KEY",
      "model": "openai/gpt-oss-120b",
      "daily_tokens": 200000,
      "daily_requests": 1000,
      "retry_seconds": 5
    },
    {
      "name": "openrouter",
      "base_url": "https://openrouter.ai/api/v1",
      "key_env": "OPENROUTER_API_KEY",
      "model": "openai/gpt-oss-120b:free",
      "daily_requests": 50,
      "overflow_only": true
    },
    {
      "name": "google",
      "enabled": false,
      "base_url": "https://generativelanguage.googleapis.com/v1beta/openai",
      "key_env": "GOOGLE_API_KEY",
      "model": "gemini-2.5-flash",
      "daily_tokens": 250000,
      "_note": "Free-tier content is used to improve Google's products. Explicit opt-in only."
    }
  ],
  "stress": {
    "lock_new_tools": 0.55,
    "lock_writes": 0.75,
    "relief_on_merge": 0.5,
    "survive_cycles": 5,
    "escalation_per_cycle": 0.04,
    "rejection_bump": 0.12,
    "unused_bump": 0.08,
    "broken_bump": 0.15
  },
  "prompt": {
    "max_narrative_chars": 600,
    "max_peer_chars": 400,
    "recent_commits": 8
  },
  "gate": {
    "test_timeout_seconds": 120
  },
  "protected_paths": [
    ".github/",
    "hollow.json",
    "POLICY.md",
    "hollow/",
    "tests/",
    "state/",
    "site/",
    "docs_v1/",
    "workspace/tools/registry.json",
    "pyproject.toml",
    "README.md",
    "LICENSE"
  ]
}
